{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>linchpin/renovatebot-config"
  ],
  "dependencyDashboard": true,
  "baseBranches": [
    "main"
  ],
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "conflicted",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "The only dependencies here are the actions used by this repo's own workflows.",
      "matchManagers": [
        "github-actions"
      ],
      "labels": [
        "dependencies",
        "github-actions"
      ]
    }
  ]
}
